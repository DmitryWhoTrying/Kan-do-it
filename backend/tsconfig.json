{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@prisma/client": ["../generated/prisma"],
      "@shared/*": ["../../../shared/*"]
    }
  },
  "include": ["src/**/*", "../../../shared/**/*"],
  "exclude": ["node_modules", "dist"]
}